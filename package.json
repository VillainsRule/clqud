{
    "name": "clqud",
    "type": "module",
    "scripts": {
        "start": "cd api && bun src/main.ts",
        "setup": "cd api && cp .env.example .env && nano .env",
        "prep": "bun install && cd app && bunx --bun vite build",
        "pull": "git pull && bun prep",
        "apidev": "cd api && bun --watch src/main.ts",
        "appdev": "cd app && bunx --bun vite build --watch"
    },
    "dependencies": {
        "@elysiajs/eden": "^1.4.9",
        "@monaco-editor/react": "^4.7.0",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-context-menu": "^2.3.7",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slider": "^1.4.7",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@tailwindcss/vite": "^4.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "elysia": "^1.4.30",
        "lucide-react": "^1.34.0",
        "mime": "^4.1.0",
        "mobx": "^7.0.3",
        "mobx-react-lite": "^5.0.3",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "7.18.2",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@types/bun": "^1.4.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "6.0.2",
        "vite": "8.2.2"
    }
}
